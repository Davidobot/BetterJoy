<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1"/>
    </startup>
    <runtime>
        <!-- Companion switch for app.manifest's dpiAware=true (see the comment there) - lets
        WinForms rescale controls added at runtime, not just Designer-generated ones, which
        matters here since most dialogs (Reassign, calibration) build their layout in code. -->
        <AppContextSwitchOverrides value="Switch.System.Windows.Forms.EnableWindowsFormsHighDpiAutoResizing=true" />
        <!-- Nefarius.Drivers.HidHide and Nefarius.Utilities.DeviceManagement have no .NET
        Framework build at any version (confirmed across every release of both packages) - NuGet
        can only resolve their netstandard2.0 build here, which drags in ~35 .NET Standard
        compatibility facade assemblies neither package would otherwise need. BetterJoy.csproj's
        post-build OrganizeDependencyDlls target moves those facades (and nothing else - every
        one of BetterJoy2's own real dependencies stays in the app's own root) into a Nefarius\
        subfolder so the install directory doesn't read as "BetterJoy2 has 100 mystery DLLs" -
        probing here is what tells the CLR to actually look there at bind time.
        See DOCS/DLL-ORGANIZATION.md for the full accounting of what's in that folder and why. -->
        <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
            <probing privatePath="Nefarius" />
        </assemblyBinding>
    </runtime>
    <appSettings>
        <!--Motion Server IP: the default is localhost; you can change it to 0.0.0.0 (all interfaces) or a specific LAN IP
        which is **useful if you want to access the server from another computer in a network.** Default: 127.0.0.1-->
        <add key="IP" value="127.0.0.1" />
        <!--Motion Server port: the default is 26760; if it conflicts with another server set it to anything valid
        but in that case also change the port in PadTest and cemuhook.ini accordingly. Default: 26760 -->
        <add key="Port" value="26760" />
        <!-- Start minimized to the system tray instead of showing the main window. -->
        <!-- Default: false -->
        <add key="StartInTray" value="true" />
        <!-- Hide the status log box on the main window. -->
        <!-- Default: false -->
        <add key="HideStatus" value="true" />
        <!--Whether the Motion Server is enabled or not. Default: true -->
        <add key="MotionServer" value="false" />
        <!-- DualSense Bluetooth microphone backend: true prefers VIIPER (bundled, emulates a -->
        <!-- real USB device); false uses the Virtual Audio Driver by MTT instead, if the user -->
        <!-- has installed it themselves (https://github.com/VirtualDrivers/Virtual-Audio-Driver) - -->
        <!-- BetterJoy2 never installs or configures either. Falls back to whichever backend is -->
        <!-- actually available if the preferred one is off or not found. Default: true -->
        <add key="UseViiperForDualSenseMicrophone" value="true" />

        <!-- Runs a loopback-only (127.0.0.1:6743) OpenRGB SDK protocol server, exposing one -->
        <!-- fixed "BetterJoy2" device - point OpenRGB's own Settings > SDK Client tab at -->
        <!-- 127.0.0.1:6743 to use it. Unlike OpenRgbRescan.cs's client-side nudge (which needs -->
        <!-- BetterJoy's HID device exposed to OpenRGB directly), this makes the device present -->
        <!-- in OpenRGB's list from OpenRGB's own startup instead of appearing mid-session - -->
        <!-- fixes third-party OpenRGB clients that mishandle a device showing up out of nowhere -->
        <!-- (confirmed: Artemis 2). Coexists with OpenRgbRescan.cs; enable either, both, or -->
        <!-- neither per your setup. One of OpenRgbServer.ModeDisabled/ModeEnabled/ -->
        <!-- ModeEnabledWithCache - "with cache" additionally persists the last color OpenRGB set -->
        <!-- to OpenRgbServerCachedColor below, so a service restart doesn't forget it the way a -->
        <!-- plain in-memory cache would (real hardware remembers its last color on its own; this -->
        <!-- virtual device otherwise can't). Default: Disabled -->
        <add key="OpenRgbServerMode" value="Disabled" />

        <!-- Last color OpenRGB set on the BetterJoy2 device, packed 0x00BBGGRR - only written and -->
        <!-- read by OpenRgbServer.cs itself when OpenRgbServerMode is EnabledWithCache. Not meant -->
        <!-- to be hand-edited. Default: empty (no color cached yet) -->
        <add key="OpenRgbServerCachedColor" value="" />

        <!-- Last active OpenRGB mode (Direct/Rainbow Puke/Color Shift/Battery) and each mode's -->
        <!-- own parameters (speed, color count/list, brightness) - same EnabledWithCache-only -->
        <!-- persistence as OpenRgbServerCachedColor above, and just as much not meant to be -->
        <!-- hand-edited. Pipe-delimited: activeMode|rainbowSpeed|rainbowColorCount| -->
        <!-- colorShiftSpeed|colorShiftColors (comma-separated)|batteryBrightness. Default: empty -->
        <!-- (nothing cached yet, falls back to Direct/defaults) -->
        <add key="OpenRgbServerCachedModeState" value="" />

        <!--The controller's HD rumble settings for the low/high frequency rumble. Change to change the pitch of the rumble.-->
        <!--Don't set above ~1200. Default: 40 and 120 -->
        <!--To have "stronger" rumble, try setting the low/high to 160/320-->
        <add key="LowFreqRumble" value="40" />
        <add key="HighFreqRumble" value="120" />
        <!--Rumble Setting. Turns rumble on or off.-->
        <!--On is "true"; off is "false". Default: true -->
        <add key="EnableRumble" value="true" />

        <!--Enables a input when shaking a controller, only works with DS4 for now, replaces the touchpad input (Button 13 on DirectInput)-->
        <!--On is "true"; off is "false". Default: false -->
        <add key="EnableShakeInput" value="false" />
        <!--How sensitve the shake detection should be. Default: 10-->
        <add key="ShakeInputSensitivity" value="10" />
        <!--How often should the shake input run in milliseconds. -->
        <!--Don't set this lower than 15 -->
        <!-- Default: 200 -->
        <add key="ShakeInputDelay" value="200" />

        <!-- The settings marked as controller-profile defaults below are retained for migration
             and for newly-seen profiles. Their editable values now live in Controller Profiles. -->
        <!--Swap A-B buttons; if on, this mimicks the (half of) Xbox layout by the button name, rather than by the physical layout.-->
        <!--Also swaps buttons when using "Also use for buttons/axes"-->
        <!--On is "true"; off is "false". Default: false -->
        <add key="SwapAB" value="false" />
        <!--Swap X-Y buttons; if on, this mimicks the (other half of) Xbox layout by the button name, rather than by the physical layout.-->
        <!--Also swaps buttons when using "Also use for buttons/axes"-->
        <!--On is "true"; off is "false". Default: false -->
        <add key="SwapXY" value="false" />

        <!-- Allows for calibration of the controller's gyro, accel and axes-->
        <!-- When "true", double click a controller to calibrate-->
        <!-- Default: false -->
        <add key="AllowCalibration" value="true" />

        <!-- Silently recalibrates a controller's gyro/accelerometer whenever it's detected -->
        <!-- sitting genuinely motionless for long enough - on first connection if it's never -->
        <!-- been calibrated, and later in a session too if it's ever left idle. No prompt, no -->
        <!-- notification; persists to the same calibration data the manual wizard writes. Has -->
        <!-- no effect if AllowCalibration is false. Default: true -->
        <add key="AutoCalibrationEnabled" value="true" />
        <!-- How long a stillness window runs before being judged, and how long a controller must -->
        <!-- hold its pattern for auto-calibration to commit. No absolute or relative-to-magnitude -->
        <!-- tolerance is checked against a physical unit anywhere in this feature - that was tried -->
        <!-- (both a fixed deg/s or g floor, and a version of it scaled by the reading's own size) -->
        <!-- and it could never work: the whole reason a controller needs auto-calibration is that -->
        <!-- its bias is unknown in advance, so no number picked ahead of time can be simultaneously -->
        <!-- loose enough to admit a badly miscalibrated controller's real noise floor and tight -->
        <!-- enough to reject real motion. Real hardware logs (gyro_mouse_debug.log, an uncalibrated -->
        <!-- unit, genuinely untouched) showed per-axis noise that was already bigger than every -->
        <!-- fixed/relative threshold tried. -->
        <!-- -->
        <!-- Detection instead: the window is split into a first half and a second half by time. A -->
        <!-- sensor bias - however large - sits on a fixed value, so both halves land in the same -->
        <!-- place regardless of what that place is. Real motion, or a human trying to hold -->
        <!-- something artificially steady, can't sustain that - the second half measurably drifts -->
        <!-- from the first. That drift is judged against the window's OWN observed spread -->
        <!-- (max-min), not an external constant - see AutoCalTrendFraction. Doesn't need to be -->
        <!-- long to be reliable - a real sensor bias sits flat from the first sample, so even a -->
        <!-- short window (confirmed on real hardware at 0.5s, ~100 samples/half at typical poll -->
        <!-- rate) cleanly separates it from real motion; length mostly just trades off how fast a -->
        <!-- calibration can commit against margin for outlier samples. Default: 0.5 -->
        <add key="AutoCalStillDurationSeconds" value="0.5" />
        <!-- The one tunable the trend detection above needs, and it's dimensionless rather than -->
        <!-- tied to any physical unit: the first-half/second-half drift on every axis (gyro AND -->
        <!-- accel) must be no more than this fraction of that axis's own observed spread within -->
        <!-- the window. Because it's a ratio of the signal to itself, the same value should apply -->
        <!-- whether the controller's bias is 2 deg/s or 200 deg/s - unlike a fixed or magnitude- -->
        <!-- scaled threshold, this never needs to know the bias size in advance. Default: 0.5 -->
        <add key="AutoCalTrendFraction" value="0.5" />
        <!-- Grace period after a controller connects before auto-calibration is even eligible to -->
        <!-- start watching for stillness - covers a controller sitting motionless for a couple -->
        <!-- seconds between pairing and being picked up, not sensor settling time. Default: 3 -->
        <add key="AutoCalArmDelaySeconds" value="3" />
        <!-- Writes every auto-calibration state transition (window opened, aborted and why, -->
        <!-- completed) to autocal_debug.log under the data folder (%ProgramData%\BetterJoy2 or -->
        <!-- %AppData%\BetterJoy2, whichever this install uses), in addition to the on-screen debug -->
        <!-- console (which still needs DebugType set to IMU or ALL, and only shows what's on -->
        <!-- screen while you're watching). Diagnostic only; logging changes no calibration output. -->
        <!-- Default: false -->
        <add key="AutoCalDebugLogging" value="false" />
        <!-- Buttons don't drift the way sensors do, so once nothing has been pressed for this -->
        <!-- long, that alone OVERRIDES the accel/gyro checks above and lets calibration through -->
        <!-- even if those readings look like they're drifting - that drift is exactly what a -->
        <!-- bad/absent calibration produces, so it shouldn't be able to block the fix. -->
        <!-- Deliberately long (minutes): a human cannot go this long without touching anything -->
        <!-- if they're actually holding/using the controller, so this is the "nothing has been -->
        <!-- touched in a very long time, just trust it" fallback, not the primary/fast path. -->
        <!-- Default: 120 -->
        <add key="AutoCalButtonInactivitySeconds" value="120" />
        <!-- Separately toggleable: rides the same stillness window as gyro auto-calibration -->
        <!-- above, but only ever replaces a stick's CENTER, never its range - a stillness-only -->
        <!-- pass can never produce genuine max/min range data, that needs the user actually -->
        <!-- rotating the stick to its physical edges the way the manual wizard's range phase -->
        <!-- does. Meant to fix a common first-connection symptom (stick reads off-center) with -->
        <!-- much lower risk than full range recalibration. Default: true -->
        <add key="AutoCalibrateStickCenter" value="true" />

        <!-- Allows to emulate the n64 range of joystick (.8, .8) instead of real xbox360 (1, 1). -->
        <add key="N64Range" value="false" />
        <!-- Default calibration; used for third party controller -->
        <add key="acc_sensiti" value="16384,16384,16384"/>
        <add key="gyr_sensiti" value="18500,18500,18500"/>
        <add key="stick_cal" value="0x780,0x780,0x780,0x830,0x780,0x780"/>
        <add key="deadzone" value="50"/>
        <add key="stick2_cal" value="0x780,0x780,0x780,0x830,0x780,0x780"/>
        <add key="deadzone2" value="50"/>

        <!-- Scales the xy coordinates each of the joysticks report. Increase this if you can't push the stick to its maximum. -->
        <add key="StickScalingFactor" value="1.00" />
        <add key="StickScalingFactor2" value="1.00" />

        <!-- Allows use of gyroscope tilting to get full control of the slider values (big triggers)-->
        <!-- Works on pro controller and joined joycons (pro controller case - triggers combined, joycons case - separate tilt)-->
        <!-- Default: false -->
        <add key="GyroAnalogSliders" value="false" />
        <!-- Change to -400 to change direction of tilt needed. Positive is ramp up if pointing up-->
        <!-- Default: 400 -->
        <add key="GyroAnalogSensitivity" value="500" />

        <!-- Determines whether or not to use HidHide (improves compatibility with other programs, like Steam, when set to "true") -->
        <!-- When "true", BetterJoy2 hides the Pro/Joycons from other programs entirely (they won't even enumerate the device), -->
        <!-- which avoids DI/XI clashes and conflicts that can occur the moment another program starts, regardless of that -->
        <!-- program's own "ignore this controller" settings. Requires the HidHide driver to be installed. -->
        <!-- Default: false (a brand-new install defaults this to true instead if the HidHide driver is already present - see -->
        <!-- EntryPoint.DefaultHidHideToInstalledState - this value only applies when the driver isn't installed yet) -->
        <add key="UseHidHide" value="true" />

        <!-- Remove controllers from HidHide's block list on a clean exit, so other programs can -->
        <!-- see them again once BetterJoy2 closes. Turn off to leave them hidden across restarts - -->
        <!-- useful if another program should never see them regardless of whether BetterJoy2 is running. -->
        <!-- should be false when running as a servivce -->
        <!-- Default: true -->
        <add key="UnhideOnExit" value="false" />

        <!-- Periodically scan for newly connected controllers while the app is running. -->
        <!-- Default: true -->
        <add key="PassiveScan" value="true" />

        <!-- Automatically register newly detected 3rd-party HID gamepads/joysticks (that aren't already known) as controllers, -->
        <!-- guessing Pro/Left Joycon/Right Joycon from the device name, instead of requiring manual setup via "Add Controllers". -->
        <!-- Only works for devices that actually speak the Nintendo controller protocol underneath (e.g. licensed Pro Controller clones). -->
        <!-- Default: true -->
        <add key="AutoAddControllers" value="true" />

        <!-- Never auto-add a 3rd-party controller connected over USB (some controllers identify differently per transport - -->
        <!-- e.g. show up as a distinct device over USB vs Bluetooth - blacklisting one identity from the Add Controllers -->
        <!-- dialog is usually more precise, but this blocks USB entirely regardless of which device it is). -->
        <!-- Default: false -->
        <add key="BlockAutoAddUSB" value="true" />

        <!-- Never auto-add a 3rd-party controller connected over Bluetooth. See BlockAutoAddUSB above. -->
        <!-- Default: false -->
        <add key="BlockAutoAddBluetooth" value="false" />

        <!-- Logs every DualSense raw HID report and mapping-profile lookup to -->
        <!-- dualsense_raw_debug.log in the data folder - only needed for troubleshooting a -->
        <!-- specific DualSense issue, since it writes continuously while a DualSense is connected. -->
        <!-- Default: false -->
        <add key="DualSenseDebugLogging" value="false" />

        <!-- Logs every DualShock 4 raw HID report to dualshock4_raw_debug.log in the data folder - -->
        <!-- only needed for troubleshooting/confirming the baseline byte offsets against real -->
        <!-- hardware, since it writes continuously while a DualShock 4 is connected. -->
        <!-- Default: false -->
        <add key="DualShock4DebugLogging" value="false" />

        <!-- Logs controller connect/join/split/PadId-assignment decisions to debug.log in the -->
        <!-- data folder - for troubleshooting player-slot/LED numbering and pairing issues. -->
        <!-- Default: false -->
        <add key="DebugLogging" value="false" />

        <!-- Controller-profile default: keep the HOME button LED ring light on at all times. -->
        <!-- Default: true -->
        <add key="HomeLEDOn" value="true"/>
        <!-- Controller-profile default for configurable RGB lightbars, as #RRGGBB. -->
        <!-- Default: blue -->
        <add key="LightColor" value="#0000FF"/>
        <!-- Controller-profile default. The lightbar pulse BetterJoy draws itself while a pad is -->
        <!-- parked in charge-only USB waiting for a PS press: the firmware never reaches its own -->
        <!-- charging state there, so without this the profile colour just stays lit. Glow or -->
        <!-- Disabled; colour is #RRGGBB and is scaled by the pulse; period is one full breath in -->
        <!-- seconds (1-60). Defaults: glow, amber, 10s. -->
        <add key="ChargingIndicator" value="glow"/>
        <add key="ChargeGlowColor" value="#A03000"/>
        <add key="ChargeGlowPeriodSeconds" value="10"/>
        <!-- Will use multiple lights to display the current player rather than a single LED-->
        <add key="UseIncrementalLights" value="true" />

        <!-- Determines whether or not to translate gyro movements into joystick ("joy") or mouse movement ("mouse"), or have no effect ("none") -->
        <!-- When "joy_left" or "joy_right", turn gyro movements into respective left/right joystick (mouse-like) movements -->
        <!-- When "mouse", turn gyro movements into mouse movement. Press either stick-button to reset to middle of primary display  -->
        <!-- Default: none -->
        <!-- Legacy migration hint only. New profiles independently map gyro mouse, left stick, -->
        <!-- and right stick; this key is hidden from Settings and is not used at runtime. -->
        <add key="GyroToJoyOrMouse" value="none"/>
        <!-- Whether gyro-mouse/gyro-stick uses filtered IMU or raw gyro values. Filtered mode
        shares a guarded accelerometer gravity reference for world-space yaw/pitch alignment.
        Only gyro rate creates mouse or stick movement; acceleration cannot directly steer it.
        Gyro-mouse additionally applies smoothing and stationary-bias learning. Raw mode bypasses
        gravity alignment and retains the legacy feature-specific axis mappings. -->
        <!-- Default: true -->
        <add key="UseFilteredIMU" value="true"/>
        <!-- Beta value of AHRS (Madgwick filter gain) - trades lag for noise. Lower trusts gyro -->
        <!-- integration more and corrects toward true orientation slower (more lag). Higher -->
        <!-- corrects faster but lets more accelerometer noise (hand jitter, not just gravity) -->
        <!-- through. This affects AHRS-based analog sliders and diagnostic orientation only; -->
        <!-- filtered gyro-mouse and gyro-stick use separately guarded shared gravity fusion. -->
        <!-- Default: 0.1 -->
        <add key="AHRS_beta" value="1"/>
        <!-- Sensitivity of gyro-to-mouse movements - the same value now applies whether -->
        <!-- UseFilteredIMU is true or false; raw mode used to need manually dividing this by -->
        <!-- ~15 to compensate for a degrees/radians unit mismatch between the two paths, now -->
        <!-- fixed in code (see Joycon.ProcessGyroMouseSample). -->
        <!-- Defaults put roughly one 1920x1080 screen of travel in 21.5 degrees of controller -->
        <!-- rotation, avoiding the awkward large tilt/turn range of the previous defaults. -->
        <!-- Default: 2400; 1400 -->
        <add key="GyroMouseSensitivityX" value="2400"/>
        <add key="GyroMouseSensitivityY" value="1400"/>
        <!-- Approximate controller rotation, in degrees, required to move across one screen. -->
        <!-- Lower values make the pointer faster and require less hand movement; higher values -->
        <!-- make it slower and require more. This scales X and Y together while preserving the -->
        <!-- GyroMouseSensitivityX/Y balance. With GyroMouseDirectCursor=false, Windows or a game -->
        <!-- may additionally scale relative mouse input. Default: 45.0 (the behavior above). -->
        <add key="GyroMouseScreenTraversalDegrees" value="21.5"/>
        <!-- World-space rates use an adaptive 2D exponential filter. The time value controls -->
        <!-- low-speed smoothing; filtering blends away between half and all of the angular-speed -->
        <!-- threshold so ordinary pointer sweeps remain smooth and fast turns remain responsive. -->
        <!-- Set either value to 0 to disable. Defaults: 18 ms; 120 degrees/sec. -->
        <add key="GyroMouseSmoothingTimeMs" value="8"/>
        <add key="GyroMouseSmoothingThreshold" value="10"/>
        <!-- Soft low-speed stabilization adapted from JoyShockLibrary's reference mouse sample. -->
        <!-- Below this angular speed (degrees/sec), gyro gain ramps smoothly from zero to full. -->
        <!-- Unlike a deadzone it preserves fine motion, and it adds no filtering delay. Set 0 to -->
        <!-- disable. Default: 2.0 -->
        <add key="GyroMouseTighteningThreshold" value="10"/>
        <!-- Affects both filtered and raw gyro-mouse. Filtered mode uses world-space mapping: -->
        <!-- fused gravity aligns yaw and pitch to the player, while measured gyro -->
        <!-- rate remains the sole movement source. Raw mode uses gyro-only orientation mapping. -->
        <!-- Set false only to compare with direct local-Y/Z rate mapping. -->
        <!-- Default: true -->
        <add key="GyroMouseRollCompensation" value="true"/>
        <!-- Point-and-click mode: place the cursor by exact pixel deltas instead of submitting -->
        <!-- relative mouse input for Windows to rescale with pointer speed/acceleration. This -->
        <!-- preserves a closed gyro path all the way through to the visible cursor. Set false -->
        <!-- for games that specifically require relative mouse input. -->
        <!-- Default: true -->
        <add key="GyroMouseDirectCursor" value="true"/>
        <!-- When exact point-and-click gyro cursor mode reaches an edge of the monitor that -->
        <!-- currently contains the pointer, continue from the opposite edge. This restores -->
        <!-- unlimited gyro travel without affecting ordinary relative mouse/game input. It is -->
        <!-- ignored when GyroMouseDirectCursor=false. Default: true -->
        <add key="GyroMouseScreenWrap" value="false"/>
        <!-- Prefer the optional FakerInput virtual HID keyboard/mouse when its driver is -->
        <!-- installed. This lets controller mouse input, media controls, and preset shortcuts -->
        <!-- reach elevated applications, UAC, and the Windows login screen when BetterJoy2 runs -->
        <!-- as a service. If absent/unavailable, logged-in sessions keep using the existing -->
        <!-- Windows input path where possible; Ctrl+Alt+Delete and pre-login output require the -->
        <!-- driver. Set false to force fallback even when FakerInput is installed. Default: true -->
        <add key="UseFakerInput" value="true"/>
        <!-- For investigating issues with gyro mouse input - writes to -->
        <!-- gyro_mouse_debug.log in this app's data folder while gyro-mouse is active. Off by -->
        <!-- default: the logging itself (file I/O roughly every 150ms) is its own source of -->
        <!-- timing interference. Only turn on while deliberately capturing a test. -->
        <!-- Default: false -->
        <add key="GyroMouseDebugLogging" value="false"/>
        <!-- TEMPORARY gyro-to-joystick capture. While gyro is active, writes one CSV row per -->
        <!-- controller report to gyro_stick_debug.csv in this app's data folder. It records the -->
        <!-- applied output beside the AHRS/Euler diagnostic comparator and all three calibrated -->
        <!-- angular-rate samples so timing, axis selection, acceleration contamination, and -->
        <!-- stick shaping remain distinguishable. Diagnostic only; logging changes no output. -->
        <!-- Default: false -->
        <add key="GyroStickDebugLogging" value="true"/>
        <!-- Sensitivity of gyro-to-joystick movements -->
        <!-- Default: 40.0; 10.0 (if using raw values, decrease by a factor of ~15: eg 2.6, 0.6) -->
        <add key="GyroStickSensitivityX" value="100"/>
        <add key="GyroStickSensitivityY" value="85"/>
        <!-- GyroStickReduction was here: a hidden global raw divisor for the physical stick, -->
        <!-- with no UI, read once at controller construction. Replaced by the per-profile -->
        <!-- GyroStickReduction[XY][Left|Right] below, surfaced as Gyro > Stick reduction. Nothing reads -->
        <!-- the old key any more; an existing copy in a user config is inert and can be left. -->
        <!-- Degrees of controller tilt for full stick deflection in Absolute tilt/Hybrid gyro- -->
        <!-- stick mode (see GyroStickMode below) - has no effect in Rate mode. Starting points -->
        <!-- to tune by feel, not validated numbers. Default: 45; 35 -->
        <add key="GyroStickTiltRangeX" value="45"/>
        <add key="GyroStickTiltRangeY" value="35"/>
        <!-- In Hybrid gyro-stick mode, how much of the same rate-based contribution Rate mode -->
        <!-- uses gets layered on top of the absolute-tilt position. 0 behaves like plain Absolute -->
        <!-- tilt; higher values add more rate-based responsiveness near the edges of the tilt -->
        <!-- range. Starting point to tune by feel. Default: 0.3 -->
        <add key="GyroStickHybridRateWeight" value="0.3"/>
        <!-- Controller-profile default, independently per stick. How gyro-to-stick output -->
        <!-- responds to controller motion: "rate" turns proportional to how fast you're rotating -->
        <!-- (release = stop turning, good for shooter camera aim) - this is the long-standing -->
        <!-- default and behavior. "absolute" maps stick position directly to current tilt angle, -->
        <!-- self-centering when leveled, like a motion steering wheel or HOTAS stick - good for -->
        <!-- driving/flight sim. "hybrid" is absolute tilt with extra rate-based responsiveness -->
        <!-- layered on top (see GyroStickHybridRateWeight). Only takes effect when UseFilteredIMU -->
        <!-- is true; raw mode always behaves as "rate". Default: rate; rate -->
        <add key="GyroStickModeLeft" value="rate"/>
        <add key="GyroStickModeRight" value="rate"/>
        <!-- Controller-profile default, independently per stick. Which rotation drives gyro-to- -->
        <!-- stick's X axis: "yaw" (twisting the controller like a doorknob) or "roll" (banking it -->
        <!-- side-to-side, for flight-sim-style aileron input). Y always follows pitch. Only takes -->
        <!-- effect when UseFilteredIMU is true. Default: yaw; yaw -->
        <add key="GyroStickAxisXLeft" value="yaw"/>
        <add key="GyroStickAxisXRight" value="yaw"/>
        <!-- Controller-profile default, independently per stick. Flips the sign of gyro-to- -->
        <!-- stick's X/Y output after mode and axis selection are applied - e.g. invert Y for a -->
        <!-- flight-sim pitch convention. Only takes effect when UseFilteredIMU is true. -->
        <!-- Default: false; false; false; false -->
        <add key="GyroStickInvertXLeft" value="false"/>
        <add key="GyroStickInvertYLeft" value="false"/>
        <add key="GyroStickInvertXRight" value="false"/>
        <add key="GyroStickInvertYRight" value="false"/>
        <!-- Controller-profile default, independently per stick and axis. Caps how far gyro -->
        <!-- alone may deflect a stick, as a percentage of full range - the physical stick can -->
        <!-- still reach full deflection independently on top of a capped gyro contribution. -->
        <!-- Works in both raw and filtered IMU mode. Default: 100 (uncapped) for all four. -->
        <add key="GyroStickMaxDeflectionXLeft" value="100"/>
        <add key="GyroStickMaxDeflectionYLeft" value="100"/>
        <add key="GyroStickMaxDeflectionXRight" value="100"/>
        <add key="GyroStickMaxDeflectionYRight" value="100"/>
        <!-- Controller-profile default, independently per stick and axis. The instant real gyro -->
        <!-- rotation is detected (not sensor noise at rest), output jumps to at least this -->
        <!-- percentage of full deflection instead of ramping up from near-zero - keeps small -->
        <!-- gyro nudges from falling below a game's own in-game stick deadzone. Works in both -->
        <!-- raw and filtered IMU mode. Default: 0 (no floor) for all four. -->
        <add key="GyroStickMinDeflectionXLeft" value="0"/>
        <add key="GyroStickMinDeflectionYLeft" value="0"/>
        <add key="GyroStickMinDeflectionXRight" value="0"/>
        <add key="GyroStickMinDeflectionYRight" value="0"/>
        <!-- Controller-profile default, independently per stick and axis. How much of the -->
        <!-- PHYSICAL stick is removed while a gyro-stick output is active, as a percentage: -->
        <!-- 0 leaves the stick untouched, 100 inhibits it completely. The gyro contribution is -->
        <!-- added on top and the sum is clamped, so raising this trades thumb range for gyro -->
        <!-- headroom at full deflection. Replaces the old hidden global GyroStickReduction, -->
        <!-- which was a single raw divisor for both sticks (and is now unused). -->
        <!-- Default: 0 (no reduction) for all four. -->
        <add key="GyroStickReductionXLeft" value="0"/>
        <add key="GyroStickReductionYLeft" value="0"/>
        <add key="GyroStickReductionXRight" value="0"/>
        <add key="GyroStickReductionYRight" value="0"/>
        <!-- Controller-profile default. Gyro Hold/Toggle activation; true will require the mapped button to be continuously held down to keep gyro active -->
        <!-- Default: true [hold], false [toggle] -->
        <add key="GyroHoldToggle" value="false"/>
        <!-- Controller-profile default. When enabled, controller buttons assigned to mouse -->
        <!-- actions are withheld from the virtual controller while gyro mouse is active. -->
        <add key="GyroMouseInhibitButtons" value="true"/>
        <!-- When two joycons are connected, it would take the gyro movement of the right joycon for mouse movement. This swaps that -->
        <!-- Default: false -->
        <add key="GyroMouseLeftHanded" value="false"/>
        <!-- Controller-profile default. Changes drag behaviour. -->
        <!-- Will only apply to mouse buttons being mapped -->
        <!-- Default: false -->
        <add key="DragToggle" value="false"/>
        <!-- Controller-profile defaults for touchpad mouse. Activation itself is an independent -->
        <!-- binding and defaults Disabled in ControllerMappings, so these do nothing until the -->
        <!-- selected touchpad profile explicitly enables that output. -->
        <add key="TouchpadMouseInhibitButtons" value="true"/>
        <!-- Per-controller touchpad mouse response, expressed as a percentage. Default: 100 -->
        <add key="TouchpadSensitivity" value="100"/>
        <!-- Per-controller floating touchpad-stick response. Default: 100 -->
        <add key="TouchpadStickSensitivity" value="100"/>
        <!-- Per-axis touchpad pointer output scaling. Zero locks that axis. Default: 100 -->
        <add key="TouchpadHorizontalScale" value="100"/>
        <add key="TouchpadVerticalScale" value="100"/>
        <!-- Tap dragging: disabled, hold (one continuous touch), or double_tap. -->
        <!-- Default: disabled -->
        <add key="TouchpadTapAndHold" value="disabled"/>
        <!-- DS4/DualSense report only a digital pad-click bit, not analog finger pressure. -->
        <!-- Freeze pointer deltas while that click is held so depressing the pad cannot drag the -->
        <!-- cursor away from the intended target. Default: true -->
        <add key="TouchpadClickMovementLockout" value="true"/>
        <!-- Recognize two-finger vertical travel as assignable up/down gestures. Their default -->
        <!-- mappings emit ordinary wheel input while touchpad mouse is active. Default: true -->
        <add key="TouchpadTwoFingerScroll" value="true"/>

        <!-- Bindable controller buttons for gyro-mouse actions, ONLY while gyro-mouse -->
        <!-- is actually active (see the profile's Activate Gyro to Mouse mapping) - meant for using the -->
        <!-- controller as a mouse substitute, so these are inert the rest of the time rather than -->
        <!-- stealing a button from its normal game mapping. Bind via Controller Profiles; value is -->
        <!-- "joy_N" (a Joycon.Button index), a "+"-joined combo of several, or "0" for unbound - -->
        <!-- see Joycon.ProcessGyroMouseSample/SimulateGyroMouseButton/SimulateGyroMouseScroll. -->
        <!-- Clench Gyro suppresses pointer motion while held, allowing the controller to be -->
        <!-- repositioned without moving the cursor. Default: 0 (unbound) for all six. -->
        <add key="left_click" value="joy_11"/>
        <add key="right_click" value="joy_12"/>
        <add key="center_click" value="0"/>
        <add key="scroll_up" value="0"/>
        <add key="scroll_down" value="0"/>
        <add key="clench_gyro" value="joy_1"/>
        <!-- Ratchet gyro: while held, zeroes gyro-to-stick output (left/right stick) instead of -->
        <!-- tracking live rotation - lets you twist your wrist back to a comfortable angle -->
        <!-- without that repositioning motion registering as a reverse turn, or a mid-turn hold -->
        <!-- continuing to turn on its own - like disengaging a ratchet wrench, which stops -->
        <!-- turning the bolt while you reposition your grip rather than spinning it on its own. -->
        <!-- Only affects gyro-to-stick output; gyro-mouse is unaffected. Default: 0 (unbound) -->
        <add key="ratchet_gyro" value="0"/>

        <!-- Controller-profile defaults used to seed the "Use as" selector. -->
        <!-- Determines whether or not the program will expose detected controllers as Xbox controllers -->
        <!-- When "false", BetterJoy2 is only usable with programs that support UDPServer. -->
        <!-- Default: true -->
        <add key="ShowAsXInput" value="true" />
        <!-- Have ShowAsXInput as false if using this -->
        <!-- Default: false -->
        <add key="ShowAsDS4" value="false"/>

        <!-- Controller-profile default: automatically power off controllers at program exit -->
        <!-- Default: false -->
        <add key="AutoPowerOff" value="true" />
        <!-- Controller-profile default: automatically power off controllers after a period of inactivity (in minutes) -->
        <!-- Default: 30 (-1 indicates infinite time) -->
        <add key="PowerOffInactivity" value="5" />
        <!-- Controller-profile default: power off controllers when Capture (left only) or Home (right only or combined) buttons are pressed for a long interval -->
        <!-- Default: true -->
        <add key="HomeLongPowerOff" value="true" />
        <!-- Controller-profile default: how long that button must be held before powering off, in seconds (1-10) -->
        <!-- Default: 2 -->
        <add key="HomeLongPowerOffHoldSeconds" value="2" />

        <!-- Double click sticks on joycons (L3, R3) to change joycon orientation -->
        <!-- Default: true -->
        <add key="ChangeOrientationDoubleClick" value="false" />
        <!-- Do not rejoin joycons once split via clicking on their icon -->
        <!-- When 'true' allows you to double-click the joycons to split them and then change their orientation to vertical -->
        <!-- Default: false -->
        <add key="DoNotRejoinJoycons" value="false" />

        <!-- Determines what type of debugging information to be printed -->
        <!-- None = 0 -->
        <!-- All = 1 -->
        <!-- Comms = 2 -->
        <!-- Threading = 3 -->
        <!-- IMU = 4 -->
        <!-- Rumble = 5 -->
        <!-- Shake Input = 6 -->
        <!-- Default: 0 -->
        <add key="DebugType" value="0" />
    </appSettings>
</configuration>
