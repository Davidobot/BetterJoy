  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- Nefarius.Drivers.HidHide and Nefarius.Utilities.DeviceManagement have no .NET Framework
       build at any published version, so NuGet resolves their netstandard2.0 build here instead
       - which drags in ~35 .NET Standard compatibility facade assemblies (netstandard.dll,
       System.Buffers.dll, System.Security.Cryptography.*.dll, ...) that exist only because of
       those two packages, not because BetterJoy's own code needs them. Moves everything the
       normal build/copy step puts in the output folder that ISN'T one of BetterJoy's real direct
       dependencies into a Nefarius\ subfolder, so the install directory doesn't read as
       "BetterJoy has 100 mystery DLLs". App.config's <probing privatePath="Nefarius"> is what
       tells the CLR to actually look there at bind time. See DOCS/DLL-ORGANIZATION.md for the
       full accounting.
       Keep-list approach (move everything NOT explicitly kept) rather than an explicit list of
       the ~35 facade names to move: the exact facade set NuGet resolves can shift slightly
       between package version bumps, but BetterJoy's own direct references almost never do - a
       keep-list is far less likely to silently go stale than a move-list would be. -->
  <Target Name="OrganizeDependencyDlls" AfterTargets="Build">
    <ItemGroup>
      <NefariusDependencyDll Include="$(OutDir)*.dll"
          Exclude="$(OutDir)Concentus.dll;$(OutDir)Crc32.NET.dll;$(OutDir)NAudio.dll;$(OutDir)Nefarius.Drivers.HidHide.dll;$(OutDir)Nefarius.Utilities.DeviceManagement.dll;$(OutDir)Nefarius.ViGEm.Client.dll;$(OutDir)WindowsInput.dll" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)Nefarius" Condition="'@(NefariusDependencyDll)' != '' And !Exists('$(OutDir)Nefarius')" />
    <Move SourceFiles="@(NefariusDependencyDll)" DestinationFolder="$(OutDir)Nefarius" Condition="'@(NefariusDependencyDll)' != ''" />
  </Target>
